// markdownlint-cli2 configuration. Mirrors the haproxy-haptic/haptic
// repo's rules so writing style stays consistent across the group.
{
  "config": {
    "MD013": false,
    "MD024": false,
    "MD029": false,
    "MD033": false,
    "MD036": false,
    "MD040": false,
    "MD041": false,
    "MD046": false,
    "MD056": false,
    "MD060": false
  },
  "ignores": [
    "node_modules/**",
    ".claude/**",
    ".cache/**",
    "target/**"
  ]
}
